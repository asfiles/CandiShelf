# ============================================================================
# npm supply-chain hardening
# ============================================================================

# Do NOT run dependencies' install/lifecycle scripts. This blocks the single
# most common npm supply-chain attack vector: a malicious (or compromised)
# package executing arbitrary code via a postinstall/preinstall script the
# moment you run `npm install`.
#
# Explicit `npm run <script>` for THIS project (dev/build/test/tauri) still
# works. If a dependency ever legitimately needs its build script, allow it
# deliberately with `npm rebuild <pkg>` — never by disabling this globally.
ignore-scripts=true

# When adding a dependency, pin the exact version (no floating "^"/"~" range),
# so an install can't silently pull a newer, unreviewed release.
save-exact=true

# Fail fast if the local Node.js violates the "engines" field, keeping every
# environment on a known, consistent toolchain.
engine-strict=true

# Deterministic, quieter installs.
fund=false
audit-level=high
